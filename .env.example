# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# Ne jamais committer .env.local (déjà exclu par .gitignore).

# Projet Supabase : atebs-inspire-core (iwoohdtbcgmsdzuxwniw)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — Supabase → Project Settings → API → service_role secret.
# Utilisée UNIQUEMENT côté serveur (Server Actions sous /admin, route
# /api/test/complete) — ne JAMAIS préfixer par NEXT_PUBLIC_, jamais exposée
# au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# SSO Ateb ID — laisser VIDE en local. En production, définir au domaine
# racine partagé entre toutes les apps Ateb, précédé d'un point, ex. :
# AUTH_COOKIE_DOMAIN=.atebsinspire.com
# Le site principal doit lui-même être servi depuis un sous-domaine de ce
# domaine (ex. www.atebsinspire.com) — un cookie ne peut pas être partagé
# entre des domaines racines différents. Voir DECISION-LOG.md.
AUTH_COOKIE_DOMAIN=

# L'accès à /admin passe désormais par le compte Supabase Auth du site
# (voir DECISION-LOG.md, 01/09/2026) — plus de mot de passe partagé séparé.
# Pour donner l'accès admin à un compte : ajouter son user_id dans la table
# admin_users (voir supabase/migrations/20260901090000_add_admin_users_table.sql).

# Newsletter / emailing (à brancher en V2)
NEWSLETTER_PROVIDER_API_KEY=

# Paiement (à brancher en V2)
PAYMENT_PROVIDER_SECRET_KEY=

# URL publique du site — sert de base aux liens canoniques et au partage
# social (Open Graph). Laisser vide en local (repli sur localhost). En
# production, définir à l'URL réelle une fois le domaine acheté, ex. :
# NEXT_PUBLIC_SITE_URL=https://www.atebsinspire.com
NEXT_PUBLIC_SITE_URL=
